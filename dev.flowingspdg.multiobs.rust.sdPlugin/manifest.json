{
  "UUID": "dev.flowingspdg.multiobs.rust",
  "Name": "Multi OBS",
  "Author": "FlowingSPDG",
  "Description": "Control any number of OBS Studio instances from Stream Deck.",
  "Version": "0.1.0.0",
  "Icon": "imgs/plugin",
  "Category": "Multi OBS",
  "CategoryIcon": "imgs/plugin",
  "CodePath": "bin/win-x64/dev.flowingspdg.multiobs.rust.exe",
  "CodePathMac": "bin/osx/dev.flowingspdg.multiobs.rust",
  "PropertyInspectorPath": "ui/index.html",
  "SDKVersion": 2,
  "Software": { "MinimumVersion": "6.5" },
  "OS": [
    { "Platform": "windows", "MinimumVersion": "10" },
    { "Platform": "mac", "MinimumVersion": "12" }
  ],
  "Actions": [
    { "UUID": "dev.flowingspdg.multiobs.rust.stream", "Name": "Stream", "Icon": "imgs/actions/stream", "Tooltip": "Toggle streaming. Long press stops.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }, { "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.record", "Name": "Record", "Icon": "imgs/actions/record", "Tooltip": "Toggle recording. Long press stops.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }, { "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.recordpause", "Name": "Record Pause", "Icon": "imgs/actions/recordpause", "Tooltip": "Pause or resume recording.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }, { "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.replay", "Name": "Replay Buffer", "Icon": "imgs/actions/replay", "Tooltip": "Toggle the replay buffer. Long press stops it.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }, { "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.savereplay", "Name": "Save Replay", "Icon": "imgs/actions/savereplay", "Tooltip": "Save the replay buffer.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.virtualcam", "Name": "Virtual Camera", "Icon": "imgs/actions/virtualcam", "Tooltip": "Toggle the virtual camera. Long press stops it.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }, { "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.studiomode", "Name": "Studio Mode", "Icon": "imgs/actions/studiomode", "Tooltip": "Toggle studio mode. Long press turns it off.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }, { "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.studiotransition", "Name": "Studio Transition", "Icon": "imgs/actions/studiotransition", "Tooltip": "Trigger the studio mode transition.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.scene", "Name": "Scene", "Icon": "imgs/actions/scene", "Tooltip": "Switch the program scene. Long press sets the preview scene.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }, { "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.source", "Name": "Source Visibility", "Icon": "imgs/actions/source", "Tooltip": "Toggle a source. Long press hides it.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }, { "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.mute", "Name": "Audio Mute", "Icon": "imgs/actions/mute", "Tooltip": "Toggle mute. Long press mutes.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }, { "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.filter", "Name": "Filter", "Icon": "imgs/actions/filter", "Tooltip": "Toggle a filter. Long press disables it.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }, { "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.collection", "Name": "Scene Collection", "Icon": "imgs/actions/collection", "Tooltip": "Switch scene collection.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }, { "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.profile", "Name": "Profile", "Icon": "imgs/actions/profile", "Tooltip": "Switch the OBS profile.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }, { "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.screenshot", "Name": "Screenshot", "Icon": "imgs/actions/screenshot", "Tooltip": "Save a source screenshot.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.hotkey", "Name": "Hotkey", "Icon": "imgs/actions/hotkey", "Tooltip": "Trigger an OBS hotkey.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.refreshbrowser", "Name": "Refresh Browser", "Icon": "imgs/actions/refreshbrowser", "Tooltip": "Refresh a browser source.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.refreshcapture", "Name": "Refresh Capture", "Icon": "imgs/actions/refreshcapture", "Tooltip": "Reactivate a capture device.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.chapter", "Name": "Chapter Marker", "Icon": "imgs/actions/chapter", "Tooltip": "Create a recording chapter.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.media", "Name": "Media Control", "Icon": "imgs/actions/media", "Tooltip": "Control a media source.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }, { "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.stats", "Name": "Stats", "Icon": "imgs/actions/stats", "Tooltip": "Show OBS performance stats.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.volume", "Name": "Volume Dial", "Icon": "imgs/actions/volume", "Tooltip": "Adjust input volume. Press to mute.", "Controllers": ["Encoder"], "Encoder": { "layout": "$B1" }, "States": [{ "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.raw", "Name": "Raw Request", "Icon": "imgs/actions/raw", "Tooltip": "Send one obs-websocket request.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }] },
    { "UUID": "dev.flowingspdg.multiobs.rust.rawbatch", "Name": "Raw Batch", "Icon": "imgs/actions/rawbatch", "Tooltip": "Send an obs-websocket request batch.", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/key" }] }
  ]
}
